        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Текст комментария",
            "example": "Событие понравилось"
          },
          "eventId": {
            "uniqueItems": true,
            "type": "integer",
            "description": "id идентификатора события",
            "example": 1
          }
        },
        "description": "Данные нового комментария"
      },
