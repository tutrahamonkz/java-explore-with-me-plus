            "example": "2024-12-31 15:10:05"
          },
          "eventId": {
            "type": "integer",
            "description": "Идентификатор",
            "format": "int64",
            "example": 3
          },
          "description": {
            "type": "string",
            "description": "Текст комментария",
            "example": "Событие понравилось"
          }
        },
        "description": "Комментарий события"
      },
      "NewCommentDto": {
        "required": [
          "description"
